<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Stated here as well as in samples/Directory.Build.props, because `docker build` sees only this
       folder. No PackageReferences, for the same reason: central package management lives up the tree. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ContainerOrders</RootNamespace>
  </PropertyGroup>

  <!-- TODO 3 (solved): `dotnet publish -t:PublishContainer` builds on chiseled Ubuntu: no shell, no
       package manager, and a fraction of the packages to patch. InvariantGlobalization keeps the SDK
       from picking the -extra variant, which adds ICU and time zone data that this app doesn't need.
       No ContainerUser: the SDK runs the app as the image's non-root `app` user (UID 1654). -->
  <PropertyGroup>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
