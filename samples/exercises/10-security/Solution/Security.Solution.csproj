<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Where `dotnet user-secrets` and `dotnet user-jwts` keep this app's development signing key.
         The starter uses the same id, so a token you create works against both. -->
    <UserSecretsId>dotnet-primer-10-security</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
