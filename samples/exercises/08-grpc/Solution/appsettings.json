{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // gRPC needs HTTP/2. Over plain HTTP, Kestrel can't negotiate it, so the endpoint serves HTTP/2 only.
  // The port is the one the gRPC page's client examples use.
  "Kestrel": {
    "Endpoints": {
      "Grpc": { "Url": "http://localhost:5287", "Protocols": "Http2" }
    }
  }
}
