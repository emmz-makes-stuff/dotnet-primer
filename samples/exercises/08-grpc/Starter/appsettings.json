{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // gRPC needs HTTP/2. Over plain HTTP, Kestrel can't negotiate it, so the endpoints serve HTTP/2 only.
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
